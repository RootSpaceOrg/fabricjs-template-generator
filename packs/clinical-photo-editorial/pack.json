  "format": {
    "width": 1080,
    "height": 1350
  },
  "tokens": {
    "paper": "#E5F3F2",
    "ink": "#004C4A",
    "muted": "#6E9C9A",
    "teal": "#007E7B",
    "teal-bright": "#00A9A5",
    "deep": "#004A47",
    "accent-ink": "#D8F0EE",
    "blue-scrub": "#1769A6",
    "font-display": "'Anton', sans-serif",
    "font-serif": "'DM Serif Display', serif",
    "font-body": "'Manrope', sans-serif",
    "fs-eyebrow": "22px",
    "fs-headline": "72px",
    "fs-body": "28px",
    "fs-cta": "30px",
    "radius": "28px"
  },
  "fonts": {
    "css": "https://fonts.googleapis.com/css2?family=Anton&family=DM+Serif+Display&family=Manrope:wght@400;600;700;800&display=swap",
    "meta": "Anton:400|DM Serif Display:400|Manrope:400,600,700,800"
  },
  "variables": {
    "primary": "#007E7B",
    "secondary": "#004A47"
