  },
  "assinaturas": [
    {
      "signature": "Capa: headline condensada entrelaçada com cutout profissional",
      "maps_to": {
        "recipe": "capa-fotografica",
        "components": [
          "ds-headline (data-layer)",
          "ds-slot[data-cutout]",
          "ds-eyebrow",
          "ds-cta"
        ]
      }
    },
    {
      "signature": "Conjunto: teal profundo dramático, com luz baixa e acento aqua",
      "maps_to": {
        "recipe": "photo-esquerda/photo-direita/photo-imersiva",
        "components": [
          "ds-photo",
          "ds-card",
          "ds-number"
        ]
      }
    },
    {
      "signature": "CTA: fundo verde-profundo com botão claro dominante e foto/equipamento",
      "maps_to": {
        "recipe": "cta-profundo",
        "components": [
          "ds-headline",
          "ds-body",
          "ds-cta",
          "ds-photo"
        ]
      }
    }
  ]
