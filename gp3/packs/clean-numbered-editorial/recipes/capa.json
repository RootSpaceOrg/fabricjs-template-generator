{
  "role": "capa",
  "nota": "número-total gigante + título coluna esquerda; professionalPhoto obrigatório na coluna direita ancorado na base; avatar row na base esquerda",
  "components": [
    { "c": "ds-number", "area": "1 / 2 / 4 / 6", "size": "lg", "slot": "capa_total",
      "editable": { "desc": "Número total de itens do listicle (ex: 9)", "min": 1, "max": 2 } },
    { "c": "ds-headline", "area": "4 / 2 / 8 / 8", "slot": "capa_titulo",
      "editable": { "desc": "Título do listicle, UPPERCASE, 2–3 linhas", "min": 40, "max": 80 } },
    { "c": "ds-slot", "area": "4 / 8 / 13 / 13", "slotName": "professionalPhoto", "cutout": true, "static": true },
    { "c": "ds-stamp", "area": "8 / 6 / 9 / 9", "rot": -6, "variable": "primary", "static": true, "slot": "capa_stamp" },
    { "c": "ds-slot", "area": "11 / 2 / 12 / 3", "slotName": "instagramProfilePicture", "circle": true, "static": true },
    { "c": "ds-body", "area": "11 / 3 / 12 / 7", "textType": "instagramName", "slot": "perfil_nome" },
    { "c": "ds-body", "area": "12 / 3 / 13 / 7", "tone": "muted", "textType": "instagramHandle", "slot": "perfil_handle" }
  ]
}
